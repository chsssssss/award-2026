# 이 파일을 .env.local로 복사해서 값을 채워요. .env.local은 커밋하지 않아요.
# 같은 값을 Vercel 프로젝트 Settings > Environment Variables에도 넣어야 해요.

# ── Firebase Admin SDK (서버 전용) ─────────────────────────────
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로 받은 JSON에서 옮겨요.

# JSON의 "project_id"
FIREBASE_PROJECT_ID=

# JSON의 "client_email" (예: firebase-adminsdk-xxxxx@<project-id>.iam.gserviceaccount.com)
FIREBASE_CLIENT_EMAIL=

# JSON의 "private_key" 값을 그대로 붙여넣어요. 큰따옴표로 감싸고 \n은 그대로 둬도 돼요.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── 서버 비밀 값 ────────────────────────────────────────────────
# IP 원문 대신 저장할 해시에 섞는 값. 길고 랜덤하게 (예: openssl rand -hex 32). 운영 중에 바꾸지 않아요.
IP_HASH_SALT=

# 결과 이미지 URL 서명용 비밀 값. 길고 랜덤하게 (예: openssl rand -hex 32).
RESULT_IMAGE_SECRET=

# ── 공개 값 (NEXT_PUBLIC_*는 브라우저 번들에 들어가요. 비밀 값을 넣지 않아요) ──
# 사이트 주소. 끝에 / 없이. 공유 링크와 OG 이미지 절대 경로에 써요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 화면에 보여 줄 문의 이메일
NEXT_PUBLIC_CONTACT_EMAIL=

# PostHog 분석(선택). 비워 두면 분석을 보내지 않고 라이브러리도 내려받지 않아요.
# PostHog 프로젝트 설정의 "Project API key"(phc_로 시작, 공개용 키)를 넣어요.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog 수집 주소. US 클라우드는 https://us.i.posthog.com, EU 클라우드는 https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry 오류 기록(선택). 비워 두면 보내지 않아요. Sentry 프로젝트(award-2026)의 Client Keys(DSN).
# DSN은 브라우저에 들어가는 공개 값이에요.
NEXT_PUBLIC_SENTRY_DSN=
# 빌드할 때 소스맵을 올리는 Sentry 인증 토큰(비밀 값). Vercel 환경변수에만 넣고 커밋하지 않아요.
SENTRY_AUTH_TOKEN=
# /api/dev/sentry-test?key=이 값 일 때만 일부러 에러를 던져요(Sentry 연결 확인용). 길고 랜덤하게. 비우면 항상 404.
SENTRY_TEST_KEY=
